FROM mayo_clinic:latest

SHELL ["/bin/bash", "-o", "pipefail", "-c"]

# CPU-only model-construction probe for the official CUDA-11.6/Python-3.8
# stack. The inference graph vendors its small Detectron2/timm surface, so the
# image only installs text-tokenizer/configuration dependencies here.
RUN python -m pip install --no-cache-dir packaging==24.2 && \
    python -m pip install --no-cache-dir \
      hydra-core==1.3.2 \
      transformers==4.40.0 \
      safetensors==0.4.5 \
      pillow==10.4.0 \
      sentencepiece==0.2.0

ENV TRANSFORMERS_OFFLINE=1 \
    HF_HUB_OFFLINE=1 \
    TOKENIZERS_PARALLELISM=false

CMD ["python", "--version"]
